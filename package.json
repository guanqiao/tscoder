{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "tscoder",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.0",
  "scripts": {
    "dev": "npm run dev --workspace=packages/tscoder",
    "dev:desktop": "npm run tauri --workspace=packages/desktop -- dev",
    "dev:web": "npm run dev --workspace=packages/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "hello": "echo 'Hello World!'",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": [
    "packages/*",
    "packages/console/*",
    "packages/sdk/js",
    "packages/slack",
    "sdks/*"
  ],
  "devDependencies": {
    "@actions/artifact": "5.0.1",
    "@tsconfig/bun": "1.0.9",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "sst": "3.17.23",
    "turbo": "2.5.6",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.933.0",
    "@tscoder/plugin": "*",
    "@tscoder/script": "*",
    "@tscoder/sdk": "*",
    "typescript": "5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/tscoder"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "web-tree-sitter"
  ],
  "overrides": {
    "@types/bun": "1.3.8",
    "@types/node": "22.13.9"
  },
  "patchedDependencies": {
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch"
  }
}
