#!/bin/sh
set -e
# Check if node version matches package.json
node -e '
const fs = require("fs");
const path = require("path");

const pkgPath = path.join(__dirname, "..", "package.json");
const pkg = JSON.parse(fs.readFileSync(pkgPath, "utf8"));

const expectedNodeVersion = pkg.engines?.node;
if (expectedNodeVersion) {
  const currentNodeVersion = process.version;
  console.log(`Node.js version: ${currentNodeVersion} (required: ${expectedNodeVersion})`);
}
'

# Run typecheck with node
cd packages/tscoder && npm run typecheck
